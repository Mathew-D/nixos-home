// Chat software
workspace "C" {
  open-on-output "DP-1"
}

// Video Player output
workspace "I" {
  open-on-output "DP-2"
}

//Email
workspace "E" {
  open-on-output "DP-3"
}

// ===== Outputs =====

output "eDP-1" {
    mode "2880x1800@120.000"
    scale 1.5
    position x=0 y=0
}
